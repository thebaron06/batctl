# batctl configuration
# Fronius Gen24 Symo battery charge/discharge controller
#
# Quick start:
#   1. Set [connection] host to your inverter's hostname or IP.
#   2. Run:  batctl detect --config batctl.conf
#      This auto-fills [battery] and [detected] from the inverter.
#   3. Set [location] for your site (required for time-based features).
#   4. Enable features in [features] one at a time and test with --dry-run.
#
# All command-line --section.key flags override the corresponding value here.

# ---------------------------------------------------------------------------
[connection]
# ---------------------------------------------------------------------------
host      = fronius-wr.home   # inverter hostname or IP
port      = 502               # Modbus TCP port (default: 502)
slave_id  = 1                 # Modbus slave ID (default: 1)

# ---------------------------------------------------------------------------
[features]
# All features default to false → behaviour is identical to the original
# charge-taper-only mode.  Enable them one by one and test with --dry-run.
#
# Compatibility rules (enforced at startup):
#   end_of_day_full_charge  requires  charge_limit AND [location]
#   night_grid_export       requires  [location] AND [battery] capacity_kwh > 0
#   weather_aware           requires  night_grid_export AND [weather] settings
# ---------------------------------------------------------------------------
charge_limit           = false   # cap charging at [charging] upper_soc_limit
end_of_day_full_charge = false   # lift cap near sunset so battery reaches 100%
night_grid_export      = false   # discharge to grid overnight (sunset→sunrise)
weather_aware          = false   # skip export when tomorrow's forecast is poor

# ---------------------------------------------------------------------------
[charging]
# ---------------------------------------------------------------------------
upper_soc_limit    = 80     # charge_limit hard cap (%) — battery won't charge
                            # above this during the day
min_charge_rate_w  = 300    # lower bound for the taper-computed charge rate (W)

# ---------------------------------------------------------------------------
[charge_taper]
# Charge rate reduction rules (replaces charge_rules.conf).
# Format:  soc_threshold_percent = scale_factor   (scale: 0.0 – 1.0)
# Rules are evaluated highest-threshold-first; first match wins.
# At the matched SoC the charge rate is capped at:
#   max(min_charge_rate_w, scale × WChaMax)
# ---------------------------------------------------------------------------
95 = 0.05
90 = 0.10
80 = 0.30

# ---------------------------------------------------------------------------
[end_of_day]
# ---------------------------------------------------------------------------
lead_time_minutes = 120   # switch to full-charge mode this many minutes before
                          # sunset (requires end_of_day_full_charge = true)

# ---------------------------------------------------------------------------
[grid_export]
# ---------------------------------------------------------------------------
reserve_soc        = 12    # minimum SoC (%) to keep at sunrise; covers morning
                           # consumption (breakfast etc.) until PV production
                           # takes over — 12% ≈ 0.9 kWh on a 7.7 kWh battery
min_discharge_rate_w = 300 # lower bound for the computed discharge rate (W)

# ---------------------------------------------------------------------------
[battery]
# Populated automatically by:  batctl detect --config batctl.conf
# Re-run detect whenever you change the battery or inverter hardware.
# ---------------------------------------------------------------------------
capacity_kwh = 0      # usable energy capacity (kWh); 0 = not yet detected
wchamax_w    = 0      # informational: max charge/discharge power from inverter

# ---------------------------------------------------------------------------
[location]
# Required by end_of_day_full_charge and night_grid_export.
# Used to compute sunrise and sunset times (fully offline, no network needed).
# ---------------------------------------------------------------------------
latitude  =           # decimal degrees, e.g. 48.21
longitude =           # decimal degrees, e.g. 16.37
timezone  =           # IANA timezone name, e.g. Europe/Vienna

# ---------------------------------------------------------------------------
[weather]
# Required by weather_aware = true.
# Uses Open-Meteo (https://open-meteo.com) — free, no API key needed.
#
# Expected production is estimated as:
#   kWh/m²/day (from forecast) × pv_peak_kwp × performance_ratio
#
# If tomorrow's expected production < skip_export_below_kwh, grid export
# is skipped and the battery is kept for next-day home consumption.
#
# The forecast is cached locally so it is fetched only a few times per day.
# The cache is auto-invalidated when the location changes.
# To manually clear the cache:  rm <cache_path>
# ---------------------------------------------------------------------------
pv_peak_kwp           = 0      # installed PV peak power in kWp
performance_ratio     = 0.75   # system efficiency factor (losses, wiring, etc.)
skip_export_below_kwh = 10     # don't export if tomorrow's forecast is below this
refresh_hours         = 6      # re-fetch forecast if cache is older than this
cache_path            = /tmp/batctl_weather_cache.json

# ---------------------------------------------------------------------------
[detected]
# Written automatically by:  batctl detect --config batctl.conf
# ---------------------------------------------------------------------------
manufacturer =
model        =
serial       =
firmware     =
